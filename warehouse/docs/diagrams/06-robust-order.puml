@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
title UC05 创建订单 鲁邦图
actor 操作员
boundary "订单表单 / ApiController" as B
control "OrderService" as C
entity "订单/事件记录" as E
操作员 --> B
B --> C : 校验Movement请求
C --> E : 创建PENDING订单、发布ORDER_CREATED，不扣库存
C --> B : 返回订单ID
@enduml
