@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam shadowing false
title UC03 入库 序列图
actor 操作员 as U
boundary "入库表单/HTTP API" as B
control "InventoryService" as C
database "H2" as DB
U -> B : 校验Movement请求
B -> C : 调用用例操作
C -> DB : 条件累加库存、写入库单、发布STOCK_RECEIVED
DB --> C : 结果
C --> B : 返回入库单ID
B --> U : 显示结果或错误
@enduml
